class Circle {
    init(radius) {
        this.radius = radius;
    }
    area {
        return 3.14 * this.radius * this.radius;
    }
    class unit {
        return Circle(1);
    }
}

var circle = Circle(4);
print circle.area; // ~50
print Circle.unit.area; // 3.14
circle.area(); // Runtime Error